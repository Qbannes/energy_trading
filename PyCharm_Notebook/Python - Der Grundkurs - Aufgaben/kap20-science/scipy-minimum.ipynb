   "source": [
    "from scipy import optimize\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "f = lambda x: x/8 + 2/x\n",
    "result = optimize.minimize(f, 1.0)\n",
    "print(result)"
   ],
